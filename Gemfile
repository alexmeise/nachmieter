source "https://rubygems.org"

# Use the github-pages gem so local builds match GitHub Pages' environment.
gem "github-pages", group: :jekyll_plugins

# Theme
gem "minima"

# Windows / JRuby compatibility and faster file watching (harmless elsewhere)
gem "webrick", "~> 1.8"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end
